generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      String   @default("Cashier") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model customers {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  phone    String?    @db.VarChar(50)
  orders   orders[]
  vehicles vehicles[]

}

model invoices {
  id           Int       @id @default(autoincrement())
  invoice_no   String    @unique @db.VarChar(100)
  order_id     Int
  total_amount Decimal   @db.Decimal(12, 2)
  issued_at    DateTime? @default(now()) @db.Timestamp(6)
  orders       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_order")
}

model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  service_id Int
  qty        Int?     @default(1)
  subtotal   Decimal  @db.Decimal(12, 2)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_order")
  services   services @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_service")
}

model orders {
  id             Int           @id @default(autoincrement())
  order_date     DateTime?     @default(now()) @db.Timestamp(6)
  service_status String?       @default("Waiting") @db.VarChar(50)
  payment_status String?       @default("Unpaid") @db.VarChar(50)
  customer_id    Int
  vehicle_id     Int
  staff_id       Int?
  check_in_time  String?       @db.VarChar(50)

  invoices       invoices[]
  order_items    order_items[]
  payments       payments[]

  customers      customers     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_customer")
  vehicles       vehicles      @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_vehicle")
  staffs         staffs?       @relation(fields: [staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_staff")
}

model payments {
  id              Int       @id @default(autoincrement())
  order_id        Int
  amount_received Decimal   @db.Decimal(12, 2)
  change_amount   Decimal?  @default(0) @db.Decimal(12, 2)
  payment_method  String    @db.VarChar(50)
  payment_date    DateTime? @default(now()) @db.Timestamp(6)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_order")
}

model services {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  duration    Int
  price       Decimal       @db.Decimal(12, 2)
  status      String?       @default("Active") @db.VarChar(50)
  order_items order_items[]
}

model vehicles {
  id           Int       @id @default(autoincrement())
  plate_number String    @unique @db.VarChar(50)
  brand        String    @db.VarChar(100)
  model        String    @db.VarChar(100)
  customer_id  Int
  orders       orders[]
  customers    customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer")
}

model staffs {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(255)
  phone   String?  @db.VarChar(50)
  status  String?  @default("Active") @db.VarChar(50)
  orders  orders[]
}
