generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CASHIER
  CUSTOMER
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum OrderServiceStatus {
  WAITING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

model users {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")

  customer customers?

  @@map("users")
}

model customers {
  id         Int       @id @default(autoincrement())
  user_id    Int?      @unique
  name       String    @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  user     users?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vehicles vehicles[]
  orders   orders[]

  @@index([deleted_at])
}

model staffs {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(255)
  phone      String?       @db.VarChar(50)
  status     ActiveStatus? @default(ACTIVE)
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  deleted_at DateTime?

  order_staff order_staff[]

  @@index([deleted_at])
}

model vehicles {
  id           Int       @id @default(autoincrement())
  plate_number String    @unique @db.VarChar(50)
  brand        String    @db.VarChar(100)
  model        String    @db.VarChar(100)
  customer_id  Int
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  deleted_at   DateTime?

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vehicle_customer")
  orders    orders[]

  @@index([customer_id])
  @@index([deleted_at])
}

model services {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(255)
  duration   Int
  price      Decimal       @db.Decimal(12, 2)
  status     ActiveStatus? @default(ACTIVE)
  image_url  String?
  image_id   String?
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  deleted_at DateTime?

  order_items order_items[]

  @@index([deleted_at])
}

model orders {
  id             Int                 @id @default(autoincrement())
  order_date     DateTime?           @default(now()) @db.Timestamp(6)
  created_at     DateTime            @default(now())
  service_status OrderServiceStatus? @default(WAITING)
  payment_status PaymentStatus?      @default(UNPAID)
  customer_id    Int
  vehicle_id     Int
  check_in_time  String?             @db.VarChar(50)

  customers   customers     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_customer")
  vehicles    vehicles      @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_vehicle")
  order_items order_items[]
  payments    payments[]
  invoices    invoices[]
  order_staff order_staff[]

  @@index([customer_id])
  @@index([vehicle_id])
  @@index([service_status])
  @@index([payment_status])
}

model order_staff {
  id          Int      @id @default(autoincrement())
  order_id    Int
  staff_id    Int
  assigned_at DateTime @default(now())

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_staff_order")
  staffs staffs @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_staff_staff")

  @@unique([order_id, staff_id])
  @@index([order_id])
  @@index([staff_id])
}

model order_items {
  id         Int     @id @default(autoincrement())
  order_id   Int
  service_id Int
  qty        Int?    @default(1)
  subtotal   Decimal @db.Decimal(12, 2)

  orders   orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_order")
  services services @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_service")

  @@index([order_id])
  @@index([service_id])
}

model payments {
  id              Int           @id @default(autoincrement())
  order_id        Int
  amount_received Decimal       @db.Decimal(12, 2)
  change_amount   Decimal?      @default(0) @db.Decimal(12, 2)
  payment_method  PaymentMethod
  payment_date    DateTime?     @default(now()) @db.Timestamp(6)

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_order")

  @@index([order_id])
}

model invoices {
  id           Int       @id @default(autoincrement())
  invoice_no   String    @unique @db.VarChar(100)
  order_id     Int
  total_amount Decimal   @db.Decimal(12, 2)
  issued_at    DateTime? @default(now()) @db.Timestamp(6)

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_order")

  @@index([order_id])
}
